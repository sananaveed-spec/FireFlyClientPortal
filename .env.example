# Copy to .env.local for local development:
#   copy .env.example .env.local
#
# Rebuild after changing any NEXT_PUBLIC_* value.

NEXT_PUBLIC_AZURE_CLIENT_ID=your-application-client-id
NEXT_PUBLIC_AZURE_TENANT_ID=your-directory-tenant-id

# Single-tenant (Fire Fly only):
#   https://login.microsoftonline.com/<Directory-tenant-ID>
# Multi-tenant work/school accounts (needed to send mail as sana@epsfresno.com):
#   https://login.microsoftonline.com/organizations
#   Also set App registration → Authentication → Supported account types to
#   "Accounts in any organizational directory".
NEXT_PUBLIC_AZURE_AUTHORITY=https://login.microsoftonline.com/organizations

# Only these email domains can use the portal after sign-in.
# Example: fireflyaccountancy.com
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=fireflyaccountancy.com

# Where client profiles are stored (default: ./data/client-profiles.json)
# DATA_DIR=./data

# --- Azure AD (portal steps, not env vars) ---
# 1. App registration → Authentication → Single-page application
#    Add redirect URI:
#      Local: http://localhost:3000
#      Production: https://your-portal-url
# 2. Supported account types: "Accounts in this organizational directory only"
# 3. API permissions (Delegated):
#      Microsoft Graph → User.Read
#      Microsoft Graph → Mail.Send  (required for Client Management → Send Now)
#    Grant admin consent for the tenant if prompted.
# 4. Restart npm run dev after changing NEXT_PUBLIC_* values
