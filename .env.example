# Local development:
#   copy .env.example .env.local
#
# Hetzner / Docker:
#   copy .env.example .env
#   then: docker compose up -d --build
#
# Rebuild after changing any NEXT_PUBLIC_* value.

NEXT_PUBLIC_AZURE_CLIENT_ID=your-application-client-id
NEXT_PUBLIC_AZURE_TENANT_ID=your-directory-tenant-id

# Single-tenant (Fire Fly only):
#   https://login.microsoftonline.com/<Directory-tenant-ID>
# Multi-tenant work/school accounts (needed to send mail as sana@epsfresno.com):
#   https://login.microsoftonline.com/organizations
#   Also set App registration → Authentication → Supported account types to
#   "Accounts in any organizational directory".
NEXT_PUBLIC_AZURE_AUTHORITY=https://login.microsoftonline.com/organizations

# Only these email domains can use the portal after sign-in.
# Example: fireflyaccountancy.com
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=fireflyaccountancy.com

# Extra individual emails allowed (comma-separated), e.g. mailbox used for Send Now.
NEXT_PUBLIC_ALLOWED_EMAILS=sana@epsfresno.com

# Where data JSON files are stored (default: ./data).
# Docker Compose sets DATA_DIR=/app/data — do not put that path in local .env.
# DATA_DIR=./data

# --- Azure AD (portal steps, not env vars) ---
# 1. App registration → Authentication → Single-page application
#    Add redirect URI:
#      Local: http://localhost:3000
#      Production: https://your-portal-url
# 2. Supported account types: "Accounts in this organizational directory only"
# 3. API permissions (Delegated):
#      Microsoft Graph → User.Read
#      Microsoft Graph → Mail.Send  (required for Client Management → Send Now)
#      Microsoft Graph → Sites.Selected  (SharePoint; grant each site via Graph)
#      Microsoft Graph → Sites.Read.All  (list sites for Portal Link picker)
#      Microsoft Graph → Group.ReadWrite.All  (create CLIENT - {Name} sites)
#      Microsoft Graph → Files.ReadWrite.All  (create year/month folders on new sites)
#      Microsoft Graph → User.ReadBasic.All  (resolve member emails when creating sites)
#      Microsoft Graph → User.Invite.All  (guest-invite Owner/POC on client sites)
#    Grant admin consent for the tenant if prompted.
# 4. For Ignition proposal.accepted → auto SharePoint (server):
#    App registration → Certificates & secrets → new client secret
#    AZURE_CLIENT_SECRET=<secret value>
#    API permissions → Application (not Delegated), admin consent:
#      Group.ReadWrite.All, User.Invite.All, User.Read.All,
#      Files.ReadWrite.All, Directory.Read.All
# 5. Restart npm run dev after changing NEXT_PUBLIC_* values

# Server-only: app registration client secret (proposal.accepted auto SharePoint
# + BD auto-send Mail.Send as supervisor).
# AZURE_CLIENT_SECRET=

# BD1/BD7/BD8 auto-send cron (POST /api/bd-auto-emails/run).
# Azure app needs Application permission Mail.Send + admin consent (you already have this).
# BD_AUTO_EMAIL_CRON_SECRET=long-random-string
# Public portal origin for signature logo links in auto-sent mail:
# IGNITION_PUBLIC_BASE_URL=https://clientportal.fireflyaccountancy.com
#
# Hetzner crontab examples (9:00 AM Eastern and 9:00 AM Pacific):
#   # 9:00 AM America/New_York ≈ 14:00 UTC (EST) / 13:00 UTC (EDT) — pick one or both
#   0 14 * * * curl -fsS -X POST -H "Authorization: Bearer $BD_AUTO_EMAIL_CRON_SECRET" http://127.0.0.1:3000/api/bd-auto-emails/run
#   # 9:00 AM America/Los_Angeles ≈ 17:00 UTC (PST) / 16:00 UTC (PDT)
#   0 17 * * * curl -fsS -X POST -H "Authorization: Bearer $BD_AUTO_EMAIL_CRON_SECRET" http://127.0.0.1:3000/api/bd-auto-emails/run


# SharePoint site used by the SharePoint tab (Sites.Selected must be granted).
# Prefer SITE_ID (from Graph GET /sites/...). Must use a Fire Fly tenant login.
NEXT_PUBLIC_SHAREPOINT_SITE_HOST=fireflyaccountancy.sharepoint.com
NEXT_PUBLIC_SHAREPOINT_SITE_PATH=/sites/TestbySana
NEXT_PUBLIC_SHAREPOINT_SITE_ID=fireflyaccountancy.sharepoint.com,xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx,yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy

# --- Ignition Core API (server-only; never use NEXT_PUBLIC_*) ---
# Enable Core API in Ignition → Settings → Labs, then create an app in
# Settings → Developer hub → Core API. Redirect URLs must include the
# callback below (local and/or production). OAuth uses PKCE (S256).
IGNITION_CLIENT_ID=
IGNITION_CLIENT_SECRET=
IGNITION_REDIRECT_URI=http://localhost:3000/api/ignition/callback
# Production example:
# IGNITION_REDIRECT_URI=https://clientportal.fireflyaccountancy.com/api/ignition/callback
IGNITION_AUTH_URL=https://developers.ignitionapp.com/oauth2/authorize
IGNITION_TOKEN_URL=https://developers.ignitionapp.com/oauth2/token
IGNITION_API_BASE=https://api.ignitionapp.com/rest/v1
# Public portal URL used to register Ignition webhooks (server deploy).
IGNITION_PUBLIC_BASE_URL=https://clientportal.fireflyaccountancy.com
# Optional override if the one-time webhook signing secret must be set manually.
# IGNITION_WEBHOOK_SECRET=whsec_...
